# Public host name that points to this server (DNS A record). Caddy obtains a Let's Encrypt certificate for it.
DOMAIN=ercaudit.example.org
# Host ports used by Caddy. Change them only if 80/443 are already taken on the server.
HTTP_PORT=80
HTTPS_PORT=443
# Only used with docker-compose.direct.yml (the app on port 8000 without HTTPS).
WEB_BIND=127.0.0.1
