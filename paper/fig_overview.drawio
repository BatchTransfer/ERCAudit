        <mxCell id="jN26qnoVaASXVH1twJ89-1" value="&lt;b&gt;Central question:&lt;/b&gt; does an ERC implementation enforce what its standard requires: who may &lt;i&gt;move&lt;/i&gt; tokens, and which &lt;i&gt;authority context&lt;/i&gt; a signature binds?" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fontSize=12;spacing=4;fillColor=#F5F5F5;strokeColor=#666666;strokeWidth=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
