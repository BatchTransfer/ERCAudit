        <mxCell id="jN26qnoVaASXVH1twJ89-6" value="&lt;i&gt;What must an ERC implementation enforce?&lt;/i&gt;&lt;div&gt;&lt;i&gt;&lt;br&gt;&lt;/i&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Prior studies &amp; incidents&lt;/div&gt;&lt;div style=&quot;text-align: left;&quot;&gt;• Derive classes and rules&lt;/div&gt;&lt;/div&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fontSize=11;spacing=4;fillColor=#FFFFFF;strokeColor=#666666;strokeWidth=1;align=left;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="479" y="382" width="183" height="80" as="geometry" />
        </mxCell>
        <mxCell id="jN26qnoVaASXVH1twJ89-7" value="10 risk classes: 5 batch + 5 domain&lt;br&gt;17 rules: 8 + 9 (R1–R9)&lt;br&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;→ &lt;i&gt;ERCAudit&lt;/i&gt; analyzer&lt;/span&gt;" style="fontFamily=Helvetica;html=1;whiteSpace=wrap;rounded=1;arcSize=6;fontSize=10;spacing=4;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1;align=center;verticalAlign=middle;fontStyle=1;" parent="1" vertex="1">
