pragma solidity ^0.8.26;

import {IERC20} from "@openzeppelin-contracts-5.0.2/token/ERC20/IERC20.sol";
import {IUniswapV2Pair} from "@uniswap-v2-core-1.0.1/contracts/interfaces/IUniswapV2Pair.sol";
import {Helper} from "../../lib/Helper.sol";
import {_USDT} from "./Const.sol";
import {CStorage} from "./CStorage.sol";
import {IUFI} from "../../interface/IUFI.sol";

contract Router is CStorage {
    /// @custom:oz-upgrades-unsafe-allow state-variable-immutable
    address public immutable token1;

    /// @custom:oz-upgrades-unsafe-allow state-variable-immutable
    address public immutable pair;

    /// @custom:oz-upgrades-unsafe-allow constructor
    constructor(address _token1) {
        token1 = _token1;
        pair = IUFI(token1).uniswapV2Pair();
    }

    uint256 private constant MINIMUM_LIQUIDITY = 1000;

    function buy(uint256 amountIn, uint256 minAmountOut) internal returns (uint256 amountOut) {
        (uint256 reserveUsdt, uint256 reserveGs,) = IUniswapV2Pair(pair).getReserves();
        amountOut = Helper.getAmountOut(amountIn, reserveUsdt, reserveGs);

        require(amountOut >= minAmountOut, "slp");
        IUniswapV2Pair(pair).swap(0, amountOut, address(this), "");
    }

    function sell(uint256 amountIn, uint256 minAmountOut) internal returns (uint256 amountOut) {
        (uint256 reserveUsdt, uint256 reserveGs,) = IUniswapV2Pair(pair).getReserves();
        amountOut = Helper.getAmountOut(amountIn, reserveGs, reserveUsdt);

        require(amountOut >= minAmountOut, "lip");

        IERC20(token1).transfer(pair, amountIn);
        IUniswapV2Pair(pair).swap(amountOut, 0, address(this), "");
    }

    function sellExactUsdt(uint256 amountOut) internal returns (uint256 amountIn) {
        (uint256 reserveUsdt, uint256 reserveGs,) = IUniswapV2Pair(pair).getReserves();
        amountIn = Helper.getAmountIn(amountOut, reserveGs, reserveUsdt);

        IERC20(token1).transfer(pair, amountIn);
        IUniswapV2Pair(pair).swap(amountOut, 0, address(this), "");
    }

    function addLiquidity(uint256 amountUsdt, uint256 amountGs) internal {
        (uint256 reserveUsdt, uint256 reserveGs,) = IUniswapV2Pair(pair).getReserves();

        uint256 amountGsOptimal = (amountUsdt * reserveGs) / reserveUsdt;
        if (amountGsOptimal <= amountGs) {
            amountGs = amountGsOptimal;
        } else {
            amountUsdt = (amountGs * reserveUsdt) / reserveGs;
        }

        IERC20(_USDT).transfer(pair, amountUsdt);
        IERC20(token1).transfer(pair, amountGs);

        IUniswapV2Pair(pair).mint(lpBurnContract);
    }
}



