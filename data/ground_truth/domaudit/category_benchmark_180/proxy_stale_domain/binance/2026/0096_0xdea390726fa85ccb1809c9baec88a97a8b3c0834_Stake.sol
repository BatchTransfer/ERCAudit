// SPDX-License-Identifier: MIT
pragma solidity 0.8.30;

import {SafeMath} from "../../lib/SafeMath.sol";
import {S1, S2, S3, S4, S5, S6, S7, S8, S9} from "./Const.sol";

struct CometInfo {
    uint32 upTime; //上次静态释放时间
    uint96 skAmount; //质押量
    uint96 staticWithdrawn; // 静态已提现
    uint96 dynamicWithdrawn; // 动态已提现
    uint96 cap;
}

abstract contract CStorage {
    using SafeMath for uint256;

    bool public closeStake;
    bool public closeWithdraw;
    bool public closeCopm;
    uint8 public inPercentU; // 入金比例

    uint256 public totalSupply; // 全网总算力
    mapping(address => uint256) public balanceOf; // 个人总质押量
    mapping(address => uint256) public staticOf; // 待领取静态

    uint256 public _maxLoop; // 最大循环次数
    uint256 public golbalRate; // 全网秒利率
    uint256 public outPercentU; // 提现比例
    address public signer;

    mapping(address => uint256) public personalRate; // 单地址秒利率
    mapping(address => bool) public personalSetRate; // 单地址利率设置

    mapping(address => CometInfo) public userReward;

    mapping(address => uint256) public teamOf; // 团队业绩
    mapping(address => uint256) public bigBranchOf; // 大区业绩
    mapping(address => address) public bigBranchNode; // 大区业绩的下级地址

    mapping(address child => address parent) public parentOf;
    mapping(address => uint256) public childCountOf; // 我有几个下级
    mapping(address => uint256) public lvOf; // 我的等级
    mapping(address => uint256) public accInOf; // 我的累积入金

    mapping(address => bool) public _isExcludedFromFee;
    mapping(address => uint256) public userNonce;
    mapping(address => uint256) public staticAllUsdt;
    mapping(address => uint256) public staticAllTok;
    mapping(address => uint256) public dynaAllUsdt;
    mapping(address => uint256) public dynaAllTok;

    //地址
    address public marketAddr;
    address public treasuryAddr;
    address public bigNodesContract;

    mapping(address => uint256) public roles; // 0 默认， 1 拒绝， 2 通过

    address public lpBurnContract;

    uint256 public outUDyna; // 提现比例
    uint256 public burnPercent; // 销毁比例

    mapping(address => uint256) public maxAmountIn;
    mapping(address => bool) public shiyan;

    uint8 public inPercentUV1_3; // 入金比例
    uint8 public inPercentUV4_6; // 入金比例
    uint8 public inPercentUV7_9; // 入金比例

    function _setPersonalRate(address _user, uint256 _rate) internal {
        personalSetRate[_user] = true;
        personalRate[_user] = _rate;
    }

    function _clearPersonalRate(address _user) internal {
        personalSetRate[_user] = false;
        personalRate[_user] = 0;
    }

    // 小区业绩
    function getSmallBranch(address _user) public view returns (uint256) {
        return teamOf[_user].safeSub(bigBranchOf[_user]).safeSub(accInOf[_user]);
    }

    // 大区业绩
    function getBigBranch(address _user) public view returns (uint256) {
        return bigBranchOf[_user] + accInOf[_user];
    }

    // V1: 考核小区3000U拿全网收益的8％
    // V2:  1万U拿全网收益的16％
    // V3:  3万U全网收益的24%
    // V4:  10万U全网收益的32%
    // V5:  30万U全网收益的40%
    // V6:  100万U全网收益的48%
    // V7:  300万U全网收益的56%
    // V8:  600万U全网收益的64%
    // V9:  1200万全网收益的72%
    function getLevel(address _user) public view returns (uint256) {
        uint256 smallBranchIn = getSmallBranch(_user);
        if (smallBranchIn >= S9) {
            return 9;
        } else if (smallBranchIn >= S8) {
            return 8;
        } else if (smallBranchIn >= S7) {
            return 7;
        } else if (smallBranchIn >= S6) {
            return 6;
        } else if (smallBranchIn >= S5) {
            return 5;
        } else if (smallBranchIn >= S4) {
            return 4;
        } else if (smallBranchIn >= S3) {
            return 3;
        } else if (smallBranchIn >= S2) {
            return 2;
        } else if (smallBranchIn >= S1) {
            return 1;
        } else {
            return 0;
        }
    }

    function getLevelRate(address _user) public view returns (uint256) {
        uint256 level = lvOf[_user];
        if (level == 9) {
            return 72;
        } else if (level == 8) {
            return 64;
        } else if (level == 7) {
            return 56;
        } else if (level == 6) {
            return 48;
        } else if (level == 5) {
            return 40;
        } else if (level == 4) {
            return 32;
        } else if (level == 3) {
            return 24;
        } else if (level == 2) {
            return 16;
        } else if (level == 1) {
            return 8;
        } else {
            return 0;
        }
    }
}



