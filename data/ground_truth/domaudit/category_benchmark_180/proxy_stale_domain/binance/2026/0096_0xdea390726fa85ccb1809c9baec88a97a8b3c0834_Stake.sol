// SPDX-License-Identifier: MIT
pragma solidity >=0.8.17;

import {CStorage} from "./CStorage.sol";

contract Member is CStorage {
    event Relation(address indexed from, address parent, uint256 timestamp);
    event UpgradeLv(address indexed from, address upper, uint256 lv, uint256 timestamp);

    function _initializeMember() internal {
        _maxLoop = 50;
    }

    //增加自己以及上级的业绩
    function addTeamValue(address user, uint256 amount) internal {
        uint256 lowerTof = teamOf[user] + amount;
        teamOf[user] = lowerTof;
        address up = parentOf[user];
        if (up == address(0)) return;
        if (bigBranchOf[up] < lowerTof) {
            bigBranchOf[up] = lowerTof;
            bigBranchNode[up] = user;
        }

        uint256 maxLoop = _maxLoop;
        for (uint256 i = 0; i < maxLoop; i++) {
            uint256 newValue = teamOf[up] + amount;
            teamOf[up] = newValue;

            uint256 level = getLevel(up);
            if (level > lvOf[up]) {
                lvOf[up] = level;
                emit UpgradeLv(user, up, level, block.timestamp);
            }

            address lower = up;
            up = parentOf[up];
            if (up == address(0)) break;
            if (bigBranchOf[up] < newValue) {
                bigBranchOf[up] = newValue;
                bigBranchNode[up] = lower;
            }
        }
    }

    function _link(address user, address next) internal {
        if (parentOf[user] != address(0)) return;
        require(user != next, "==");
        if (next == address(0)) return;

        address nextUp = parentOf[next];
        for (uint256 i = 0; i < 30; i++) {
            if (nextUp == address(0)) break;
            if (nextUp == user) return;
            nextUp = parentOf[nextUp];
        }

        parentOf[user] = next;
        childCountOf[next]++;
        emit Relation(user, next, block.timestamp);
        uint256 allIn = accInOf[user];
        if (allIn > 0) {
            teamOf[user] = 0;
            addTeamValue(user, allIn);
        }
    }

    // for owner
    struct RelactionShip {
        address p;
        address v;
    }

    function unsafeLink_(address user, address next) internal {
        parentOf[user] = next;
        emit Relation(user, next, block.timestamp);
    }
}



