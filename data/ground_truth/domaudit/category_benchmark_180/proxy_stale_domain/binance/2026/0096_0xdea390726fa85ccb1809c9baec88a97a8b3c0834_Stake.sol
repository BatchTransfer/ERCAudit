import {VerifySignature} from "./VerifySignature.sol";

abstract contract VerifySignatureV2 is VerifySignature {
    struct RequestV2 {
        uint256 id;
        uint256 amount;
        address recipient;
        uint256 deadline;
        uint256 nonce;
        uint256 wtype;
    }

    function getMessageHashV2(RequestV2 calldata request) public pure returns (bytes32) {
        return keccak256(
            abi.encodePacked(
                request.id, request.amount, request.recipient, request.deadline, request.nonce, request.wtype
            )
        );
    }

    function getEthSignedMessageHashV2(bytes32 _messageHash) public view returns (bytes32) {
        return keccak256(abi.encodePacked("\x19Ethereum Signed Message:\n32", DOMAIN_SEPARATOR, _messageHash));
    }

    function verifyV2(RequestV2 calldata request, uint8 v, bytes32 r, bytes32 s) public view returns (address) {
        bytes32 messageHash = getMessageHashV2(request);
