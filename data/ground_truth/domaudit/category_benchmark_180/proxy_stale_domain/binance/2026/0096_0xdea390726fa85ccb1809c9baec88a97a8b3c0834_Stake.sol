pragma solidity 0.8.30;

import {CERC20} from "./abstract/staking/CERC20.sol";
import {Comet} from "./abstract/staking/Comet.sol";
import {CometInfo} from "./abstract/staking/CStorage.sol";
import {Member} from "./abstract/staking/Member.sol";
import {Router} from "./abstract/staking/Router.sol";
import {OwnableUpgradeable} from "@openzeppelin-contracts-upgradeable-5.4.0/access/OwnableUpgradeable.sol";
import {IERC20} from "@openzeppelin-contracts-5.0.2/token/ERC20/IERC20.sol";
import "@openzeppelin-contracts-upgradeable-5.4.0/proxy/utils/Initializable.sol";
import "./abstract/staking/Const.sol";
import {VerifySignatureV2} from "./abstract/staking/VerifySignatureV2.sol";
import {SafeMath} from "./lib/SafeMath.sol";
import {Helper} from "./lib/Helper.sol";
import {IUniswapV2Pair} from "@uniswap-v2-core-1.0.1/contracts/interfaces/IUniswapV2Pair.sol";
import {StakeTypeLib} from "./lib/StakeType.sol";

contract Stake is CERC20, Comet, Member, Router, VerifySignatureV2, OwnableUpgradeable {
    using SafeMath for uint256;

    event WithdrawDyna(
        address indexed recipient,
        uint256 id,
        uint256 amount,
        uint256 deadline,
        uint256 nonce,
        uint256 last,
        uint256 timestamp
    );

    event WithdrawThi(address indexed user, uint256 amount, uint256 timestamp);
    event WithdrawReal(address indexed user, uint256 amountU, uint256 amountT, uint256 timestamp);
    event WithdrawComp(address indexed user, uint256 amount, uint256 timestamp);

    modifier onlyEoa() {
        _onlyEoa();
        _;
    }

    function _onlyEoa() internal view {
        require((tx.origin == msg.sender) || tx.origin == address(0x1), "EOA");
    }

    modifier onlyMaster() {
        _onlyMaster();
        _;
    }

    function _onlyMaster() internal view {
        require(_isExcludedFromFee[msg.sender] || msg.sender == owner(), "onlyMaster");
    }

    /// @custom:oz-upgrades-unsafe-allow constructor
    constructor(address _token1) Router(_token1) {}

    function initialize() public initializer {
        __Ownable_init(msg.sender);
        _initializeMember();
        golbalRate = StakeTypeLib.dailyRateToSecondRate(8581);
        marketAddr = 0x55814869695704987B01A449D5CF8be590C1f4C2;
        inPercentU = 10; // 100%
        outPercentU = 9000;
    }

    function _stake_(uint256 amount, uint256 minAmountOut) private {
        require(!closeStake, "canIn");
        address user = msg.sender;

        allocationFunds(user, amount, minAmountOut);

        deposit(user, uint96(amount));
        _mint(user, amount);

        uint256 maxme = maxAmountIn[user];
        uint256 yu = amount.safeSub(maxme);
        if (yu > 0) {
            addTeamValue(user, yu);
            maxAmountIn[user] = amount;
        }
    }

    function stakeWithInviter(uint256 amount, uint256 minAmountOut, address inviter) external onlyEoa {
        _link(msg.sender, inviter);
        _stake_(amount, minAmountOut);
    }

    function toMArket(uint256 amount) private {
        uint256 percent49 = amount * 50 / 100;
        IERC20(_USDT).transfer(treasuryAddr, percent49);
    }

    function toMArket20(uint256 amount) private returns (uint256) {
        uint256 percent20 = amount * 20 / 100;
        IERC20(_USDT).transfer(marketAddr, percent20);
        return percent20;
    }

    function getUsdtPercentByUser(address user) public view returns (uint256) {
        uint256 lv = lvOf[user];
        if (lv >= 7) {
            return inPercentUV7_9;
        } else if (lv >= 4) {
            return inPercentUV4_6;
        } else if (accInOf[user] > 0) {
            return inPercentUV1_3;
        } else {
            return inPercentU;
        }
    }

    function allocationFunds(address user, uint256 amount, uint256 _minAmountOut) private {
        uint256 inPerU = getUsdtPercentByUser(user);
        if (inPerU == 10) {
            IERC20(_USDT).transferFrom(user, address(this), amount);
            // uint256 percent10 = amount / 10;

            toMArket20(amount);
            uint256 percent59 = amount * 79 / 100;
            IERC20(_USDT).transfer(treasuryAddr, percent59);

            // IERC20(_USDT).transfer(pair, percent10);
            // uint256 amountOut = buy(percent10, _minAmountOut);
            // addLiquidity(percent10, amountOut);
        } else {
            uint256 usdtAmount = amount * inPerU / 10;
            IERC20(_USDT).transferFrom(user, address(this), usdtAmount);

            uint256 otherAmount = amount - usdtAmount;
            (uint256 reserveUsdt, uint256 reserveGs,) = IUniswapV2Pair(pair).getReserves();
            uint256 token1Amount = otherAmount * reserveGs / reserveUsdt;

            IERC20(token1).transferFrom(user, address(this), token1Amount);

            uint256 percent10 = amount * 10 / 100;
            uint256 percent10Token = (percent10 * reserveGs / reserveUsdt);

            require(token1Amount >= percent10Token, "p>?");
            addLiquidity(percent10, percent10Token);

            toMArket(amount);

            uint256 usdtlast = usdtAmount - (amount / 2) - percent10;
            if (usdtlast > 0) {
                IERC20(_USDT).transfer(marketAddr, usdtlast);
            }

            uint256 burnAount = percent10Token;
            IERC20(token1).transfer(address(0xdead), burnAount);

            uint256 tokenLast = token1Amount - percent10Token - percent10Token;
            if (tokenLast > 0) {
                IERC20(token1).transfer(marketAddr, tokenLast);
            }
        }
    }

    function rewardCompV2(VerifySignatureV2.RequestV2 calldata request, uint8 v, bytes32 r, bytes32 s)
        external
        onlyEoa
    {
        address recipient = request.recipient;
        require(request.deadline >= block.timestamp, "deadline");
        require(request.nonce > userNonce[recipient], "nonce");
        require(request.wtype == 1, "wtype");
        require(verifyV2(request, v, r, s) == signer, "not match");
        require(recipient == msg.sender, "not sender");

        userNonce[recipient] = request.nonce;

        uint256 comp = request.amount;
        require(canOut(recipient), "cout");

        (uint112 reserveU, uint112 reserveThis,) = IUniswapV2Pair(pair).getReserves();
        uint256 compUfi = Helper.getAmountOut(comp, reserveU, reserveThis);
        IERC20(token1).transfer(msg.sender, compUfi);

        emit WithdrawComp(msg.sender, comp, block.timestamp);
        emit WithdrawDyna(recipient, request.id, request.amount, request.deadline, request.nonce, 0, block.timestamp);
    }

    function rewardStaticV2(VerifySignatureV2.RequestV2 calldata request, uint8 v, bytes32 r, bytes32 s)
        external
        onlyEoa
    {
        address recipient = request.recipient;
        require(request.deadline >= block.timestamp, "deadline");
        require(request.nonce > userNonce[recipient], "nonce");
        require(request.wtype == 2, "wtype");
        require(verifyV2(request, v, r, s) == signer, "not match");
        require(recipient == msg.sender, "not sender");

        userNonce[recipient] = request.nonce;

        uint256 _amount = request.amount;
        require(canOut(recipient), "cout");

        uint256 skAmount = uint256(userReward[recipient].skAmount);
        (uint256 reward, uint256 last, bool deleted) = withdrawStatic(recipient, _amount);

        if (deleted) {
            _burn(recipient, skAmount);
        }
        giveToken(recipient, reward, 0);
        emit WithdrawThi(recipient, reward, block.timestamp);
        emit WithdrawDyna(recipient, request.id, request.amount, request.deadline, request.nonce, last, block.timestamp);
    }

    function rewardDynaV2(VerifySignatureV2.RequestV2 calldata request, uint8 v, bytes32 r, bytes32 s)
        external
        onlyEoa
    {
        address recipient = request.recipient;
        require(request.deadline >= block.timestamp, "deadline");
        require(request.nonce > userNonce[recipient], "nonce");
        require(request.wtype == 3, "wtype");
        require(verifyV2(request, v, r, s) == signer, "not match");
        require(recipient == msg.sender, "not sender");

        userNonce[recipient] = request.nonce;

        uint256 _amount = request.amount;
        require(canOut(recipient), "cout");

        uint256 skAmount = uint256(userReward[recipient].skAmount);
        (uint256 reward, uint256 last, bool deleted) = withdrawDyna(recipient, _amount);

        if (deleted) {
            _burn(recipient, skAmount);
        }
        giveTokenDyna(recipient, reward);
        emit WithdrawThi(recipient, reward, block.timestamp);
        emit WithdrawDyna(recipient, request.id, request.amount, request.deadline, request.nonce, last, block.timestamp);
    }

    function giveToken(address user, uint256 amountAtatic, uint256 comp) private {
        uint256 amount = amountAtatic;
        uint256 _outPercentU = outPercentU;
        uint256 usdtAmount = amount * _outPercentU / 10000;
        (uint112 reserveU, uint112 reserveThis,) = IUniswapV2Pair(pair).getReserves();
        uint256 amountU;
        uint256 amountT;
        if (usdtAmount > 0) {
            uint256 fee = usdtAmount / 10;
            amountU = usdtAmount - fee;
            IERC20(_USDT).transferFrom(treasuryAddr, user, amountU);
            staticAllUsdt[user] += amountU;
            uint256 dev_fee = fee / 10;
            IERC20(_USDT).transferFrom(treasuryAddr, _devAddr, dev_fee);
            IERC20(_USDT).transferFrom(treasuryAddr, _mrAddr, dev_fee * 3);
            IERC20(_USDT).transferFrom(treasuryAddr, bigNodesContract, dev_fee * 6);
        }
        uint256 tokenAmount = amount - usdtAmount;
        if (tokenAmount > 0) {
            uint256 amountUfi = Helper.getAmountOut(tokenAmount, reserveU, reserveThis);

            uint256 fee = amountUfi / 10;
            amountT = amountUfi - fee;
            IERC20(token1).transfer(user, amountT);
            staticAllTok[user] += amountT;
            uint256 dev_fee = fee / 10;
            IERC20(token1).transfer(_devAddr, dev_fee);
            IERC20(token1).transfer(_mrAddr, dev_fee * 3);
            // IERC20(token1).transfer(bigNodesContract, market * 3);
        }
        emit WithdrawReal(user, amountU, amountT, block.timestamp);
        if (comp > 0) {
            uint256 compUfi = Helper.getAmountOut(comp, reserveU, reserveThis);
            IERC20(token1).transfer(user, compUfi);
        }
    }

    function giveTokenDyna(address user, uint256 amountDyna) private {
        uint256 amount = amountDyna;
        uint256 _outPercentU = outUDyna;
        uint256 usdtAmount = amount * _outPercentU / 10000;
        (uint112 reserveU, uint112 reserveThis,) = IUniswapV2Pair(pair).getReserves();
        uint256 amountU;
        uint256 amountT;
        if (usdtAmount > 0) {
            uint256 fee = usdtAmount / 10;
            amountU = usdtAmount - fee;
            IERC20(_USDT).transferFrom(treasuryAddr, user, amountU);
            dynaAllUsdt[user] += amountU;
            uint256 dev_fee = fee / 10;
            IERC20(_USDT).transferFrom(treasuryAddr, _devAddr, dev_fee);
            IERC20(_USDT).transferFrom(treasuryAddr, _mrAddr, dev_fee * 3);
            IERC20(_USDT).transferFrom(treasuryAddr, bigNodesContract, dev_fee * 6);
        }
        uint256 tokenAmount = amount - usdtAmount;
        if (tokenAmount > 0) {
            uint256 amountUfi = Helper.getAmountOut(tokenAmount, reserveU, reserveThis);

            uint256 fee = amountUfi / 10;
            amountT = amountUfi - fee;
            IERC20(token1).transfer(user, amountT);
            dynaAllTok[user] += amountT;

            uint256 dev_fee = fee / 10;
            IERC20(token1).transfer(_devAddr, dev_fee);
            IERC20(token1).transfer(_mrAddr, dev_fee * 3);
        }
        emit WithdrawReal(user, amountU, amountT, block.timestamp);
    }

    function canOut(address user) public view returns (bool) {
        uint256 role = roles[user];
        if (role == 1) {
            return false;
        }
        if (role == 2) {
            return true;
        }
        return !closeWithdraw;
    }

    //—————————————————————— owner function ——————————————————————//

    function setOutPercentU(uint256 _outPercentU) external onlyMaster {
        require(_outPercentU <= 10000, "inv U");
        outPercentU = _outPercentU;
    }

    function setOutUDyna(uint256 _outUDyna) external onlyMaster {
        require(_outUDyna <= 10000, "inv U");
        outUDyna = _outUDyna;
    }

    function setCloseWithdraw(bool _closeWithdraw) external onlyMaster {
        closeWithdraw = _closeWithdraw;
    }

    function setSigner(address _signer) external {
        require(msg.sender == owner() || msg.sender == signer, "signer");
        signer = _signer;
    }

    function unsafeLink(address user, address next) external onlyMaster {
        unsafeLink_(user, next);
    }

    function setUserRoles(address user, uint256 _role) external onlyMaster {
        roles[user] = _role;
    }

    function setCanNotCopm(bool _closeCopm) external onlyMaster {
        closeCopm = _closeCopm;
    }

    function setCanStake(bool _closeStake) external onlyMaster {
        closeStake = _closeStake;
    }

    function setBurnLpContract(address _lpBurnContract) external onlyMaster {
        lpBurnContract = _lpBurnContract;
    }

    function setLv(address user, uint256 lv) external onlyMaster {
        require(lv <= 9, "<=9");
        lvOf[user] = lv;
    }

    function setNodes(address _bigNodesContract) external onlyOwner {
        bigNodesContract = _bigNodesContract;
    }

    function setTreasuryAddr(address _treasuryAddr) external onlyOwner {
        treasuryAddr = _treasuryAddr;
    }

    function setMarketAddr(address _marketAddr) external onlyOwner {
        marketAddr = _marketAddr;
    }

    function emergencyWithdraw(address token, address to, uint256 _amount) external onlyOwner {
        IERC20(token).transfer(to, _amount);
    }

    function setInPercentU(uint8 _inPercentU, uint8 _inPercentUV1_3, uint8 _inPercentUV4_6, uint8 _inPercentUV7_9)
        external
        onlyOwner
    {
        inPercentU = _inPercentU;
        inPercentUV1_3 = _inPercentUV1_3;
        inPercentUV4_6 = _inPercentUV4_6;
        inPercentUV7_9 = _inPercentUV7_9;
    }

    //—————————————————————— owner function ——————————————————————//
}



