pragma solidity 0.8.30;

import {CAP_1, CAP_2, CAP_3, CAP_4, CAP_5, CAP_6} from "../abstract/staking/Const.sol";

library StakeTypeLib {
    function calcuCapPower(uint96 _balance) internal pure returns (uint256, uint256) {
        if (_balance >= CAP_6) {
            return (25, CAP_6);
        } else if (_balance >= CAP_5) {
            return (24, CAP_5);
        } else if (_balance >= CAP_4) {
            return (23, CAP_4);
        } else if (_balance >= CAP_3) {
            return (22, CAP_3);
        } else if (_balance >= CAP_2) {
            return (21, CAP_2);
        } else {
            return (20, CAP_1);
        }
    }

    function firstInRequire(uint256 _accIn) internal pure returns (uint256) {
        if (_accIn >= CAP_6) {
            return CAP_6;
        } else if (_accIn >= CAP_5) {
            return CAP_5;
        } else if (_accIn >= CAP_4) {
            return CAP_4;
        } else if (_accIn >= CAP_3) {
            return CAP_3;
        } else if (_accIn >= CAP_2) {
            return CAP_2;
        } else {
            return CAP_1;
        }
    }

    /**
     * @dev 将日利率转换为秒利率
     * @param dailyRate 日利率 (0.01% = 100, 1% = 10000, 2% = 20000)
     * @return 秒利率
     */
    function dailyRateToSecondRate(uint256 dailyRate) internal pure returns (uint256) {
        require(dailyRate <= 200000000, "MAX 20000%");
        return (1e18 * dailyRate / 100_0000) / 1 days;
    }
}



