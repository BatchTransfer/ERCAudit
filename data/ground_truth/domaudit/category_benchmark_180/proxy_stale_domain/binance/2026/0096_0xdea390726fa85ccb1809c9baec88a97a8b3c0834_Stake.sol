abstract contract Comet is CStorage {
    using StakeTypeLib for uint256;
    using SafeMath for uint256;

    event Stake(address indexed user, uint256 amount, uint256 timestamp);
    event WithdrawStatic(address indexed user, uint256 amount, uint256 timestamp);

    event UpdateStatus(
        address indexed user,
        uint256 upTime,
        uint256 skAmount,
        uint256 staticWithdrawn,
        uint256 dynamicWithdrawn,
        uint256 cap,
        uint256 timestamp
    );

    // function deposit(address _user, uint96 _amount) internal {
    //     require(uint256(_amount) >= CAP_1, "minIn");
    //     CometInfo storage skInfo = userReward[_user];
    //     uint256 upTime = uint256(skInfo.upTime);
    //     if (upTime == 0) {
    //         // 初次质押
    //         uint256 _min = StakeTypeLib.firstInRequire(accInOf[_user]);
    //         require(_amount >= _min, "_min");
    //         skInfo.skAmount = _amount;
    //         skInfo.upTime = uint32(block.timestamp);

    //         (uint256 power,) = StakeTypeLib.calcuCapPower(_amount);
    //         uint96 cap = _amount * uint96(power) / 10;
    //         skInfo.cap = cap;
    //         emit Stake(_user, uint256(_amount), block.timestamp);
    //         emit UpdateStatus(_user, block.timestamp, uint256(_amount), 0, 0, uint256(cap), block.timestamp);
    //     } else {
    //         uint96 newAmount = uint96(_amount) + uint96(skInfo.skAmount);
    //         skInfo.skAmount = newAmount;

    //         (uint256 power,) = StakeTypeLib.calcuCapPower(newAmount);
    //         uint256 newCap = uint256(newAmount) * uint256(power) / 10;
    //         skInfo.cap = uint96(newCap);

    //         emit Stake(_user, uint256(_amount), block.timestamp);
    //         emit UpdateStatus(
    //             _user,
    //             block.timestamp,
    //             uint256(newAmount),
    //             (uint256(skInfo.staticWithdrawn)),
    //             uint256(skInfo.dynamicWithdrawn),
    //             uint256(skInfo.cap),
    //             block.timestamp
    //         );
    //     }
    // }

    function deposit(address _user, uint96 _amount) internal {
        require(uint256(_amount) >= CAP_1, "minIn");
        CometInfo storage skInfo = userReward[_user];
        uint256 upTime = uint256(skInfo.upTime);
        require(upTime == 0, "already staked");

        // 初次质押
        uint256 _min = StakeTypeLib.firstInRequire(accInOf[_user]);
        require(_amount >= _min, "_min");
        skInfo.skAmount = _amount;
        skInfo.upTime = uint32(block.timestamp);

        (uint256 power,) = StakeTypeLib.calcuCapPower(_amount);
        uint96 cap = _amount * uint96(power) / 10;
        skInfo.cap = cap;
        emit Stake(_user, uint256(_amount), block.timestamp);
        emit UpdateStatus(_user, block.timestamp, uint256(_amount), 0, 0, uint256(cap), block.timestamp);
    }

    function withdrawDyna(address _user, uint256 _amount)
        internal
        returns (uint256 reward, uint256 last, bool deleted)
    {
        CometInfo storage skInfo = userReward[_user];
        uint256 upTime = uint256(skInfo.upTime);
        require(upTime > 0, "!upTime");

        uint256 dynamicWithdrawn = uint256(skInfo.dynamicWithdrawn);
        uint256 staticWithdrawn = uint256(skInfo.staticWithdrawn);
        uint256 hardCap = uint256(skInfo.cap) - staticWithdrawn - dynamicWithdrawn;

        if (_amount >= hardCap) {
            reward = hardCap;
            delete userReward[_user];
            deleted = true;
            last = _amount - hardCap;
        } else {
            skInfo.dynamicWithdrawn += uint96(_amount);
            reward = _amount;
        }
        emit UpdateStatus(
            _user,
            userReward[_user].upTime,
            userReward[_user].skAmount,
            userReward[_user].staticWithdrawn,
            userReward[_user].dynamicWithdrawn,
            userReward[_user].cap,
            block.timestamp
        );
    }

    function withdrawStatic(address _user, uint256 _amount)
        internal
        returns (uint256 reward, uint256 last, bool deleted)
    {
        CometInfo storage skInfo = userReward[_user];
        uint256 upTime = uint256(skInfo.upTime);
        require(upTime > 0, "!upTime");

        uint256 dynamicWithdrawn = uint256(skInfo.dynamicWithdrawn);
        uint256 staticWithdrawn = uint256(skInfo.staticWithdrawn);
        uint256 hardCap = uint256(skInfo.cap) - staticWithdrawn - dynamicWithdrawn;

        if (_amount >= hardCap) {
            reward = hardCap;
            delete userReward[_user];
            deleted = true;
            last = _amount - hardCap;
        } else {
            skInfo.staticWithdrawn += uint96(_amount);
            skInfo.upTime = uint32(block.timestamp);
            reward = _amount;
        }
        emit UpdateStatus(
            _user,
            userReward[_user].upTime,
            userReward[_user].skAmount,
            userReward[_user].staticWithdrawn,
            userReward[_user].dynamicWithdrawn,
            userReward[_user].cap,
            block.timestamp
        );
    }

    function getComp(address _user)
        public
        view
        returns (uint256 reward, uint256 staticUsdt, uint256 staticTok, uint256 dynaUsdt, uint256 dynaTok)
    {
        staticUsdt = staticAllUsdt[_user];
        staticTok = staticAllTok[_user];
        dynaUsdt = dynaAllUsdt[_user];
        dynaTok = dynaAllTok[_user];

        return (0, staticUsdt, staticTok, dynaUsdt, dynaTok);
    }
}



