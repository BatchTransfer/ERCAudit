// ============================================================
// SPDX-License-Identifier: MIT
// solhint-disable not-rely-on-time
pragma solidity =0.8.19;

import {ERC721Upgradeable} from "@openzeppelin/contracts-upgradeable/token/ERC721/ERC721Upgradeable.sol";
import {PausableUpgradeable} from "@openzeppelin/contracts-upgradeable/security/PausableUpgradeable.sol";
import {AccessControlUpgradeable} from "@openzeppelin/contracts-upgradeable/access/AccessControlUpgradeable.sol";
import {CountersUpgradeable} from "@openzeppelin/contracts-upgradeable/utils/CountersUpgradeable.sol";
import {UUPSUpgradeable} from "@openzeppelin/contracts-upgradeable/proxy/utils/UUPSUpgradeable.sol";
import {ReentrancyGuardUpgradeable} from "@openzeppelin/contracts-upgradeable/security/ReentrancyGuardUpgradeable.sol";
import {Strings} from "@openzeppelin/contracts/utils/Strings.sol";
import {IFanpla} from "./interfaces/IFanpla.sol";
import {IERC4906Upgradeable, IERC721Upgradeable, IERC165Upgradeable} from "@openzeppelin/contracts-upgradeable/interfaces/IERC4906Upgradeable.sol";

import {EIP712Upgradeable} from "@openzeppelin/contracts-upgradeable/utils/cryptography/EIP712Upgradeable.sol";

import {ECDSAUpgradeable} from "@openzeppelin/contracts-upgradeable/utils/cryptography/ECDSAUpgradeable.sol";

error InsufficientTokenBalance(address addr);
error ExceedsMaxSupply(uint256 numberOfTokens);
error NumberOfTokensZero(uint256 numberOfTokens);
error NoRecipientsProvided(uint256 len);
error NonExistentToken(uint256 tokenId);
error RateExceedsLimit(uint256 rate);
error TransferNotAllowedWhenSBTModeEnabled(address msgSender);
error ApprovalNotAllowedTo(address addr);
error FeeTransferFailed(address sender, address receiver, uint256 amount);
error PaymentFailed(address sender, address receiver, uint256 amount);
error MintStartTimeMustBeBeforeEndTime(
  uint256 mintStartTime,
  uint256 mintEndTime
);
error MintTimeCheckFailed(uint256 mintStartTime, uint256 mintEndTime);
error ZeroAddress();
error ExpiredSignature(uint256 deadline);
error InvalidSignature(address signer, address owner);

contract FanplaNft is
  ERC721Upgradeable,
  EIP712Upgradeable,
  IERC4906Upgradeable,
  PausableUpgradeable,
  AccessControlUpgradeable,
  ReentrancyGuardUpgradeable,
  UUPSUpgradeable
{
  using CountersUpgradeable for CountersUpgradeable.Counter;
  using Strings for uint256;

  bytes32 public constant ADMIN_ROLE = keccak256("ADMIN_ROLE");
  bytes32 public constant PERMITTED_ACCOUNT_ROLE =
    keccak256("PERMITTED_ACCOUNT_ROLE");
  bytes32 public constant UPGRADER_ROLE = keccak256("UPGRADER_ROLE");
  uint256 public constant FEE_CALCULATION_DEVISOR = 10_000;
  bytes32 public constant PERMIT_TYPEHASH =
    keccak256(
      "Permit(address owner,address operator,uint256 tokenId,uint256 nonce,uint256 deadline)"
    );
  bytes32 private constant PERMIT_ALL_TYPEHASH =
    keccak256(
      "PermitAll(address owner,address operator,uint256 nonce,uint256 deadline)"
    );

  address public deployer;
  CountersUpgradeable.Counter private _tokenIdCounter;
  IFanpla public fanplaToken;
  uint256 public tokenPrice;
  address public artistTreasury;
  address public artistWallet;
  address public primarySaleOperationalWallet;
  uint256 public primarySaleOperationalFeeRate;
  address public secondarySaleOperationalWallet;
  uint256 public secondarySaleOperationalFeeRate;
  uint256 public royaltyRate;
  address public royaltyRecipient;
  mapping(uint256 => string) private _tokenURIs;
  string private _contractBaseURI;
  uint256 public maxSupply;
  bool public hasVotingRight;
  uint256 private _totalSupply;
  bool public isSBTEnabled;
  bool public isRevealed;
  string public preRevealURI;
  uint256 public mintStartTime;
  uint256 public mintEndTime;
  mapping(address => CountersUpgradeable.Counter) private _nonces;

  struct InitializationParams {
    string name;
    string symbol;
    string version;
    address admin;
    address initialDeployer;
    address fanplaTokenAddress;
    address artistTreasuryAddress;
    address artistWalletAddress;
    address initialPrimarySaleOperationalWallet;
    uint256 initialPrimarySaleOperationalFeeRate;
    address initialSecondarySaleOperationalWallet;
    uint256 initialSecondarySaleOperationalFeeRate;
    uint256 initialTokenPrice;
    uint256 initialFeeRate;
    uint256 initialRoyaltyRate;
    address initialRoyaltyRecipient;
    bool revealed;
    uint256 initialMintStartTime;
    uint256 initialMintEndTime;
  }

  struct MintParams {
    address to;
    uint256 numberOfTokens;
    uint256 fplValue;
    uint256 deadline;
    uint8 v;
    bytes32 r;
    bytes32 s;
  }

  struct NftPermitParams {
    address owner;
    address operator;
    uint256 tokenId;
    uint256 deadline;
    uint8 v;
    bytes32 r;
    bytes32 s;
  }

  struct FPLPermitParams {
    address owner;
    uint256 value;
    uint256 deadline;
    uint8 v;
    bytes32 r;
    bytes32 s;
  }

  struct PaymentBreakdown {
    uint256 operationalFee;
    uint256 royaltyFee;
    uint256 finalAmount;
    address operationalWallet;
    address royaltyWallet;
    address finalPayee;
  }

  event Minted(
    address indexed recipient,
    uint256 startTokenId,
    uint256 quantity
  );

  event AdminMinted(
    address indexed caller,
    address indexed recipient,
    uint256 startTokenId,
    uint256 quantity
  );

  event TransferWithPayment(
    address indexed from,
    address indexed to,
    uint256 price,
    uint256 tokenId
  );

  event OperationalWalletUpdated(address indexed wallet, bool isSecondarySale);

  event OperationalFeeRateUpdated(uint256 newFeeRate, bool isSecondarySale);

  event RoyaltyRateUpdated(uint256 newRoyaltyRate);

  event RoyaltyRecipientUpdated(address newRoyaltyRecipient);

  modifier mintTimeCheck() {
    if (block.timestamp <= mintStartTime || block.timestamp >= mintEndTime)
      revert MintTimeCheckFailed(mintStartTime, mintEndTime);
    _;
  }

  /// @custom:oz-upgrades-unsafe-allow constructor
  constructor() {
    _disableInitializers();
  }

  function initialize(InitializationParams calldata params) public initializer {
    if (params.initialMintStartTime > params.initialMintEndTime)
      revert MintStartTimeMustBeBeforeEndTime(
        params.initialMintStartTime,
        params.initialMintEndTime
      );

    __ERC721_init(params.name, params.symbol);
    __EIP712_init(params.name, params.version);
    __Pausable_init();
    __ReentrancyGuard_init();

    deployer = params.initialDeployer;
    fanplaToken = IFanpla(params.fanplaTokenAddress);
    artistTreasury = params.artistTreasuryAddress;
    artistWallet = params.artistWalletAddress;
    tokenPrice = params.initialTokenPrice;
    primarySaleOperationalWallet = params.initialPrimarySaleOperationalWallet;
    primarySaleOperationalFeeRate = params.initialPrimarySaleOperationalFeeRate;
    secondarySaleOperationalWallet = params
      .initialSecondarySaleOperationalWallet;
    secondarySaleOperationalFeeRate = params
      .initialSecondarySaleOperationalFeeRate;
    royaltyRate = params.initialRoyaltyRate;
    royaltyRecipient = params.initialRoyaltyRecipient;
    isRevealed = params.revealed;
    mintStartTime = params.initialMintStartTime;
    mintEndTime = params.initialMintEndTime;

    _setRoleAdmin(DEFAULT_ADMIN_ROLE, ADMIN_ROLE);
    _setRoleAdmin(ADMIN_ROLE, ADMIN_ROLE);
    _setRoleAdmin(UPGRADER_ROLE, ADMIN_ROLE);
    _setRoleAdmin(PERMITTED_ACCOUNT_ROLE, ADMIN_ROLE);
    _setupRole(ADMIN_ROLE, params.admin);
    _setupRole(ADMIN_ROLE, params.initialDeployer);
    _setupRole(PERMITTED_ACCOUNT_ROLE, params.admin);
    _setupRole(PERMITTED_ACCOUNT_ROLE, params.initialDeployer);
    _setupRole(UPGRADER_ROLE, params.admin);
  }

  function mint(
    MintParams calldata params
  ) public whenNotPaused onlyRole(ADMIN_ROLE) nonReentrant mintTimeCheck {
    uint256 numberOfTokens = params.numberOfTokens;

    if (_totalSupply + numberOfTokens > maxSupply)
      revert ExceedsMaxSupply(numberOfTokens);

    uint256 totalPrice = tokenPrice * numberOfTokens;
    address to = params.to;

    if (fanplaToken.balanceOf(to) < totalPrice)
      revert InsufficientTokenBalance(to);

    uint256 startTokenId = _tokenIdCounter.current() + 1;

    _handleFPLPermit(
      totalPrice,
      to,
      params.fplValue,
      params.deadline,
      params.v,
      params.r,
      params.s
    );

    address payee = hasVotingRight ? artistTreasury : artistWallet;

    _handleFPLPayment(to, payee, totalPrice, false);

    _mintTokens(to, numberOfTokens);

    emit Minted(to, startTokenId, numberOfTokens);
  }

  function _mint(address to, uint256 tokenId) internal override {
    super._mint(to, tokenId);
    _totalSupply++;
  }

  function transferWithPayment(
    NftPermitParams calldata nftParams,
    FPLPermitParams calldata fplParams,
    uint256 price,
    bool isSecondarySale
  ) public whenNotPaused nonReentrant onlyRole(ADMIN_ROLE) {
    if (fanplaToken.balanceOf(fplParams.owner) < price)
      revert InsufficientTokenBalance(fplParams.owner);

    address payer = fplParams.owner;
    address payee = isSecondarySale
      ? nftParams.owner
      : hasVotingRight
        ? artistTreasury
        : artistWallet;

    _handleFPLPermit(
      price,
      payer,
      fplParams.value,
      fplParams.deadline,
      fplParams.v,
      fplParams.r,
      fplParams.s
    );

    _handleFPLPayment(payer, payee, price, isSecondarySale);

    uint256 tokenId = nftParams.tokenId;

    _handleNftPermit(nftParams);

    address from = isSecondarySale ? nftParams.owner : address(this);
    if (isSecondarySale) {
      safeTransferFrom(from, payer, tokenId);
    } else {
      _transfer(from, payer, tokenId);
    }

    emit TransferWithPayment(from, payer, price, tokenId);
  }

  function _handleFPLPermit(
    uint256 price,
    address owner,
    uint256 value,
    uint256 deadline,
    uint8 v,
    bytes32 r,
    bytes32 s
  ) internal {
    address spender = address(this);
    uint256 allowance = fanplaToken.allowance(owner, spender);

    if (allowance < price) {
      fanplaToken.permit(owner, spender, value, deadline, v, r, s);
    }
  }

  // slither-disable-next-line arbitrary-send-erc20
  function _handleFPLPayment(
    address payer,
    address payee,
    uint256 totalPrice,
    bool isSecondarySale
  ) internal {
    PaymentBreakdown memory breakdown = _calculatePaymentBreakdown(
      totalPrice,
      payee,
      isSecondarySale
    );

    bool success = fanplaToken.transferFrom(
      payer,
      breakdown.operationalWallet,
      breakdown.operationalFee
    );
    if (!success)
      revert FeeTransferFailed(
        payer,
        breakdown.operationalWallet,
        breakdown.operationalFee
      );

    if (isSecondarySale && breakdown.royaltyFee > 0) {
      success = fanplaToken.transferFrom(
        payer,
        breakdown.royaltyWallet,
        breakdown.royaltyFee
      );
      if (!success)
        revert FeeTransferFailed(
          payer,
          breakdown.royaltyWallet,
          breakdown.royaltyFee
        );
    }

    success = fanplaToken.transferFrom(
      payer,
      breakdown.finalPayee,
      breakdown.finalAmount
    );
    if (!success)
      revert PaymentFailed(payer, breakdown.finalPayee, breakdown.finalAmount);
  }

  function _handleNftPermit(NftPermitParams calldata params) internal {
    bool isTransferable = _isApprovedOrOwner(params.operator, params.tokenId);

    if (!isTransferable) {
      permit(params);
    }
  }

  function _calculatePaymentBreakdown(
    uint256 totalPrice,
    address payee,
    bool isSecondarySale
  ) private view returns (PaymentBreakdown memory) {
    PaymentBreakdown memory breakdown;

    uint256 feeRate = isSecondarySale
      ? secondarySaleOperationalFeeRate
      : primarySaleOperationalFeeRate;

    breakdown.operationalFee = (totalPrice * feeRate) / FEE_CALCULATION_DEVISOR;
    breakdown.operationalWallet = isSecondarySale
      ? secondarySaleOperationalWallet
      : primarySaleOperationalWallet;

    if (isSecondarySale) {
      breakdown.royaltyFee =
        (totalPrice * royaltyRate) /
        FEE_CALCULATION_DEVISOR;
      breakdown.royaltyWallet = royaltyRecipient;
      breakdown.finalAmount =
        totalPrice -
        breakdown.operationalFee -
        breakdown.royaltyFee;
    } else {
      breakdown.royaltyFee = 0;
      breakdown.royaltyWallet = address(0);
      breakdown.finalAmount = totalPrice - breakdown.operationalFee;
    }

    breakdown.finalPayee = payee;

    return breakdown;
  }

  function _mintTokens(address to, uint256 numberOfTokens) internal {
    for (uint256 i = 0; i < numberOfTokens; i++) {
      _tokenIdCounter.increment();
      uint256 tokenId = _tokenIdCounter.current();
      _mint(to, tokenId);
    }
  }

  function adminMint(
    address[] calldata recipients,
    uint256 numberOfTokens
  ) public whenNotPaused onlyRole(ADMIN_ROLE) nonReentrant {
    if (numberOfTokens <= 0) revert NumberOfTokensZero(numberOfTokens);
    if (recipients.length == 0) revert NoRecipientsProvided(recipients.length);
    uint256 totalTokensToMint = numberOfTokens * recipients.length;
    if (_totalSupply + totalTokensToMint > maxSupply)
      revert ExceedsMaxSupply(numberOfTokens);

    for (uint256 i = 0; i < recipients.length; i++) {
      uint256 startTokenId = _tokenIdCounter.current() + 1;
      for (uint256 j = 0; j < numberOfTokens; j++) {
        _tokenIdCounter.increment();
        uint256 tokenId = _tokenIdCounter.current();
        _mint(recipients[i], tokenId);
      }

      emit AdminMinted(
        _msgSender(),
        recipients[i],
        startTokenId,
        numberOfTokens
      );
    }
  }

  function setTokenPrice(uint256 newPrice) public onlyRole(ADMIN_ROLE) {
    tokenPrice = newPrice;
  }

  function setOperationalWallet(
    address newWallet,
    bool isSecondarySale
  ) public onlyRole(ADMIN_ROLE) {
    if (newWallet == address(0)) revert ZeroAddress();
    if (isSecondarySale) {
      secondarySaleOperationalWallet = newWallet;
    } else {
      primarySaleOperationalWallet = newWallet;
    }
    emit OperationalWalletUpdated(newWallet, isSecondarySale);
  }

  function setArtistWallet(address newWallet) public onlyRole(ADMIN_ROLE) {
    if (newWallet == address(0)) revert ZeroAddress();
    artistWallet = newWallet;
  }

  function setFanplaTokenAddress(
    address newFanplaToken
  ) public onlyRole(ADMIN_ROLE) {
    if (newFanplaToken == address(0)) revert ZeroAddress();
    fanplaToken = IFanpla(newFanplaToken);
  }

  function setVotingRight(bool votingRight) public onlyRole(ADMIN_ROLE) {
    hasVotingRight = votingRight;
  }

  function setArtistTreasury(
    address newArtistTreasury
  ) public onlyRole(ADMIN_ROLE) {
    if (newArtistTreasury == address(0)) revert ZeroAddress();
    artistTreasury = newArtistTreasury;
  }

  function setBaseURI(string calldata newBaseURI) public onlyRole(ADMIN_ROLE) {
    _contractBaseURI = newBaseURI;
  }

  function setPreRevealURI(
    string calldata newPreRevealURI
  ) public onlyRole(ADMIN_ROLE) {
    preRevealURI = newPreRevealURI;
  }

  function baseURI() public view returns (string memory) {
    return _contractBaseURI;
  }

  function setTokenURI(
    uint256 tokenId,
    string calldata _tokenURI
  ) public onlyRole(ADMIN_ROLE) {
    if (!_exists(tokenId)) revert NonExistentToken(tokenId);
    _tokenURIs[tokenId] = _tokenURI;
    emit MetadataUpdate(tokenId);
  }

  function setMaxSupply(uint256 newMaxSupply) public onlyRole(ADMIN_ROLE) {
    maxSupply = newMaxSupply;
  }

  function setOperationalFeeRate(
    uint256 newFeeRate,
    bool isSecondarySale
  ) public onlyRole(ADMIN_ROLE) {
    if (newFeeRate > 1 * FEE_CALCULATION_DEVISOR)
      revert RateExceedsLimit(newFeeRate);

    if (isSecondarySale) {
      secondarySaleOperationalFeeRate = newFeeRate;
    } else {
      primarySaleOperationalFeeRate = newFeeRate;
    }
    emit OperationalFeeRateUpdated(newFeeRate, isSecondarySale);
  }

  function setRoyaltyRate(uint256 newRoyaltyRate) public onlyRole(ADMIN_ROLE) {
    if (newRoyaltyRate > 1 * FEE_CALCULATION_DEVISOR)
      revert RateExceedsLimit(newRoyaltyRate);
    royaltyRate = newRoyaltyRate;
    emit RoyaltyRateUpdated(newRoyaltyRate);
  }

  function setRoyaltyRecipient(
    address newRoyaltyRecipient
  ) public onlyRole(ADMIN_ROLE) {
    if (newRoyaltyRecipient == address(0)) revert ZeroAddress();
    royaltyRecipient = newRoyaltyRecipient;
    emit RoyaltyRecipientUpdated(newRoyaltyRecipient);
  }

  function burn(uint256 tokenId) public whenNotPaused onlyRole(ADMIN_ROLE) {
    if (!_exists(tokenId)) revert NonExistentToken(tokenId);
    _burn(tokenId);
  }

  function _burn(uint256 tokenId) internal override {
    super._burn(tokenId);
    _totalSupply--;
  }

  function _baseURI() internal view override returns (string memory) {
    return _contractBaseURI;
  }

  function tokenURI(
    uint256 tokenId
  ) public view override returns (string memory) {
    if (!_exists(tokenId)) revert NonExistentToken(tokenId);

    string memory _tokenURI = _tokenURIs[tokenId];

    if (bytes(_tokenURI).length > 0) return _tokenURI;

    if (isRevealed == false) return preRevealURI;

    return string.concat(_baseURI(), tokenId.toString(), ".json");
  }

  function setRevealed(bool revealed) public onlyRole(ADMIN_ROLE) {
    isRevealed = revealed;
  }

  function totalSupply() public view returns (uint256) {
    return _totalSupply;
  }

  function approve(
    address to,
    uint256 tokenId
  ) public override(ERC721Upgradeable, IERC721Upgradeable) whenNotPaused {
    if (!hasRole(PERMITTED_ACCOUNT_ROLE, to)) revert ApprovalNotAllowedTo(to);
    super.approve(to, tokenId);
  }

  function setApprovalForAll(
    address operator,
    bool approved
  ) public override(ERC721Upgradeable, IERC721Upgradeable) whenNotPaused {
    if (!hasRole(PERMITTED_ACCOUNT_ROLE, operator))
      revert ApprovalNotAllowedTo(operator);
    super.setApprovalForAll(operator, approved);
  }

  function setSBTMode(bool bool_) external virtual onlyRole(ADMIN_ROLE) {
    isSBTEnabled = bool_;
  }

  function setMintingPeriod(
    uint256 newMintStartTime,
    uint256 newMintEndTime
  ) public onlyRole(ADMIN_ROLE) {
    if (newMintStartTime > newMintEndTime)
      revert MintStartTimeMustBeBeforeEndTime(newMintStartTime, newMintEndTime);
    mintStartTime = newMintStartTime;
    mintEndTime = newMintEndTime;
  }

  function isApprovedOrOwner(
    address spender,
    uint256 tokenId
  ) public view returns (bool) {
    return super._isApprovedOrOwner(spender, tokenId);
  }

  function permit(NftPermitParams calldata params) public {
    address owner = params.owner;
    address operator = params.operator;
    uint256 tokenId = params.tokenId;
    uint256 deadline = params.deadline;

    //slither-disable-next-line timestamp
    if (block.timestamp > params.deadline) {
      revert ExpiredSignature(params.deadline);
    }

    if (!hasRole(PERMITTED_ACCOUNT_ROLE, operator))
      revert ApprovalNotAllowedTo(operator);

    bytes32 structHash = keccak256(
      abi.encode(
        PERMIT_TYPEHASH,
        owner,
        operator,
        params.tokenId,
        _useNonce(owner),
        deadline
      )
    );

    bytes32 hash = _hashTypedDataV4(structHash);

    address signer = ECDSAUpgradeable.recover(
      hash,
      params.v,
      params.r,
      params.s
    );
    if (signer != owner) {
      revert InvalidSignature(signer, owner);
    }

    _approve(operator, tokenId);
  }

  function permitAll(
    address owner,
    address operator,
    uint256 deadline,
    bool approved,
    uint8 v,
    bytes32 r,
    bytes32 s
  ) public {
    //slither-disable-next-line timestamp
    if (block.timestamp > deadline) {
      revert ExpiredSignature(deadline);
    }

    if (!hasRole(PERMITTED_ACCOUNT_ROLE, operator))
      revert ApprovalNotAllowedTo(operator);

    bytes32 structHash = keccak256(
      abi.encode(
        PERMIT_ALL_TYPEHASH,
        owner,
        operator,
        _useNonce(owner),
        deadline
      )
    );

    bytes32 hash = _hashTypedDataV4(structHash);

    address signer = ECDSAUpgradeable.recover(hash, v, r, s);
    if (signer != owner) {
      revert InvalidSignature(signer, owner);
    }

    _setApprovalForAll(owner, operator, approved);
  }

  function nonces(address owner) public view returns (uint256) {
    return _nonces[owner].current();
  }

  function _useNonce(address owner) internal virtual returns (uint256 current) {
    CountersUpgradeable.Counter storage nonce = _nonces[owner];
    current = nonce.current();
    nonce.increment();
  }

  function DOMAIN_SEPARATOR() external view returns (bytes32) {
    return _domainSeparatorV4();
  }

  function _beforeTokenTransfer(
    address from,
    address to,
    uint256 tokenId,
    uint256 batchSize
  ) internal override(ERC721Upgradeable) whenNotPaused {
    if (isSBTEnabled && from != address(0) && to != address(0))
      revert TransferNotAllowedWhenSBTModeEnabled(_msgSender());

    super._beforeTokenTransfer(from, to, tokenId, batchSize);
  }
  function pause() public onlyRole(ADMIN_ROLE) {
    _pause();
  }

  function unpause() public onlyRole(ADMIN_ROLE) {
    _unpause();
  }
  function _authorizeUpgrade(
    address _newImplementation
  ) internal override onlyRole(UPGRADER_ROLE) {}

  function supportsInterface(
    bytes4 interfaceId
  )
    public
    view
    override(ERC721Upgradeable, AccessControlUpgradeable, IERC165Upgradeable)
    returns (bool)
  {
    return super.supportsInterface(interfaceId);
  }
}



