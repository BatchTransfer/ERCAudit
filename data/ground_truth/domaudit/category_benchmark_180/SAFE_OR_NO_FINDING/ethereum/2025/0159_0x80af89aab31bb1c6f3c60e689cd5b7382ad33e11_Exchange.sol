// ============================================================
// SPDX-License-Identifier: MIT
pragma solidity 0.8.25;

import {AccessControl} from "@openzeppelin/contracts/access/AccessControl.sol";

/**
 * @title ExchangeAccess
 * @notice Handles access control and whitelisting/blacklisting functionality for the Exchange
 * @dev Inherits OpenZeppelin's AccessControl for role-based access control
 */
abstract contract ExchangeAccess is AccessControl {
    bytes32 public constant MANAGER_ROLE = keccak256("MANAGER_ROLE");

    mapping(address => bool) private blacklistUsers;
    mapping(address => bool) private whitelistedCollections;
    mapping(address => bool) private allowedPaymentTokens;

    error ZeroAddress();
    error BlacklistedUser(address user);
    error CollectionNotWhitelisted(address collection);
    error PaymentTokenNotAllowed(address token);

    event UserBlacklisted(address indexed user);
    event UserRemovedFromBlacklist(address indexed user);
    event CollectionWhitelisted(address indexed collection);
    event CollectionRemovedFromWhitelist(address indexed collection);
    event PaymentTokenAdded(address indexed token);
    event PaymentTokenRemoved(address indexed token);

    constructor(address _admin, address _manager) {
        _grantRole(DEFAULT_ADMIN_ROLE, _admin);
        _grantRole(MANAGER_ROLE, _manager);
    }

    /**
     * @notice Adds a user to the blacklist
     * @param user Address of the user to blacklist
     */
    function addBlacklistUser(address user) external onlyRole(MANAGER_ROLE) {
        if (user == address(0)) revert ZeroAddress();
        blacklistUsers[user] = true;
        emit UserBlacklisted(user);
    }

    /**
     * @notice Removes a user from the blacklist
     * @param user Address of the user to remove from blacklist
     */
    function removeBlacklistUser(address user) external onlyRole(MANAGER_ROLE) {
        if (user == address(0)) revert ZeroAddress();
        blacklistUsers[user] = false;
        emit UserRemovedFromBlacklist(user);
    }

    /**
     * @notice Adds a collection to the whitelist
     * @param collectionAddress Address of the NFT collection
     */
    function addCollectionToWhitelist(
        address collectionAddress
    ) external onlyRole(MANAGER_ROLE) {
        if (collectionAddress == address(0)) revert ZeroAddress();
        whitelistedCollections[collectionAddress] = true;
        emit CollectionWhitelisted(collectionAddress);
    }

    /**
     * @notice Removes a collection from the whitelist
     * @param collectionAddress Address of the NFT collection
     */
    function removeCollectionFromWhitelist(
        address collectionAddress
    ) external onlyRole(MANAGER_ROLE) {
        if (collectionAddress == address(0)) revert ZeroAddress();
        whitelistedCollections[collectionAddress] = false;
        emit CollectionRemovedFromWhitelist(collectionAddress);
    }

    /**
     * @notice Adds multiple payment tokens to allowed list
     * @param tokens Array of token addresses to add
     */
    function addPaymentTokens(
        address[] memory tokens
    ) external onlyRole(MANAGER_ROLE) {
        for (uint256 i = 0; i < tokens.length; i++) {
            if (tokens[i] == address(0)) revert ZeroAddress();
            allowedPaymentTokens[tokens[i]] = true;
            emit PaymentTokenAdded(tokens[i]);
        }
    }

    /**
     * @notice Removes multiple payment tokens from allowed list
     * @param tokens Array of token addresses to remove
     */
    function removePaymentTokens(
        address[] memory tokens
    ) external onlyRole(MANAGER_ROLE) {
        for (uint256 i = 0; i < tokens.length; i++) {
            if (tokens[i] == address(0)) revert ZeroAddress();
            allowedPaymentTokens[tokens[i]] = false;
            emit PaymentTokenRemoved(tokens[i]);
        }
    }

    /**
     * @notice Checks if a user is blacklisted
     * @param user Address to check
     * @return bool True if user is blacklisted
     */
    function isBlacklisted(address user) external view returns (bool) {
        return blacklistUsers[user];
    }

    /**
     * @notice Checks if a collection is whitelisted
     * @param collection Address to check
     * @return bool True if collection is whitelisted
     */
    function isWhitelistedCollection(
        address collection
    ) external view returns (bool) {
        return whitelistedCollections[collection];
    }

    /**
     * @notice Checks if a token is allowed for payments
     * @param token Address to check
     * @return bool True if token is allowed
     */
    function isAllowedPaymentToken(address token) external view returns (bool) {
        return allowedPaymentTokens[token];
    }

    function _validateUsersAndAssets(
        address leftParticipant,
        address rightParticipant,
        address collection,
        address paymentToken
    ) internal view {
        if (
            blacklistUsers[leftParticipant] || blacklistUsers[rightParticipant]
        ) {
            revert BlacklistedUser(
                blacklistUsers[leftParticipant]
                    ? leftParticipant
                    : rightParticipant
            );
        }

        if (!whitelistedCollections[collection]) {
            revert CollectionNotWhitelisted(collection);
        }

        if (!allowedPaymentTokens[paymentToken]) {
            revert PaymentTokenNotAllowed(paymentToken);
        }
    }
}



