pragma solidity 0.8.25;

import {IERC20, SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {SignatureChecker} from "@openzeppelin/contracts/utils/cryptography/SignatureChecker.sol";
import {EIP712} from "@openzeppelin/contracts/utils/cryptography/EIP712.sol";
import {IERC1155} from "@openzeppelin/contracts/token/ERC1155/IERC1155.sol";
import {IERC721} from "@openzeppelin/contracts/token/ERC721/IERC721.sol";

import {LibFill} from "./LibFill.sol";
import {ExchangeAccess} from "./ExchangeAccess.sol";

/**
 * @title Exchange
 * @notice DEX for trading NFTs (ERC721/ERC1155) with ERC20 tokens
 * @dev Uses EIP-712 for signature verification and AccessControl for permissions
 */
contract Exchange is EIP712, ExchangeAccess {
    using SafeERC20 for IERC20;

    // Constants
    uint256 public constant BASIS_POINTS = 10_000;

    /**
     * @notice Keccak-256 hash for the backend approval signature,
     * used to verify the integrity and origin of data.
     * @dev keccak256("BackendApproval(uint256 sellerFee,uint256 buyerFee,bytes32 sellOrderHash,bytes32 buyOrderHash,uint256 sellerNonce,uint256 buyerNonce)")
     */
    bytes32 public constant BACKEND_TYPEHASH =
        0x06b760a7fbe3c84f4847876b033d82ea13bcbd81179ba59eed9dc85b5d93c39f;
    /**
     * @notice Keccak-256 hash for the order signature,
     * used to verify the integrity and origin of data.
     * @dev keccak256("Order(address maker,bytes32 makeAsset,address taker,bytes32 takeAsset,uint256 salt,uint256 start,uint256 end,bool isMakeFill)")
     */
    bytes32 public constant ORDER_TYPEHASH =
        0x703c5518b2a354e9e8e29cfb734bc136d4b43c41c1e67fd5162fe1e7eec7fca7;

    // Custom errors
    error NotMaker();
    error SaltIsZero();
    error InvalidBackendSignature();
    error OrderValidationFailed();
    error InvalidSignature();
    error OrderTakerMismatch();
    error InvalidAssetPair();
    error AssetsDoNotMatch();
    error NothingToFill();
    error FeesTooHigh();

    // Enums
    enum AssetType {
        ERC721,
        ERC20,
        ERC1155,
        EMPTY
    }
    enum FeeSide {
        LEFT,
        RIGHT
    }

    // Structs
    struct Asset {
        AssetType assetClass;
        address token;
        uint256 value;
        uint256 tokenId;
    }

    struct Order {
        address maker;
        Asset makeAsset;
        address taker;
        Asset takeAsset;
        uint256 salt;
        uint256 start;
        uint256 end;
        bool isMakeFill;
    }

    struct Purchase {
        address sellOrderMaker;
        address token;
        uint256 value;
        uint256 tokenId;
        AssetType nftAssetClass;
        uint256 sellOrderPaymentAmount;
        address paymentToken;
        uint256 sellOrderSalt;
        uint sellOrderStart;
        uint sellOrderEnd;
        bytes sellOrderSignature;
        bool isMakeFillSeller;
        uint256 buyOrderPaymentAmount;
        uint256 buyOrderNftAmount;
    }

    struct AcceptBid {
        address bidMaker;
        address token;
        uint256 value;
        uint256 tokenId;
        AssetType nftAssetClass;
        uint256 bidPaymentAmount;
        address paymentToken;
        uint256 bidSalt;
        uint bidStart;
        uint bidEnd;
        bytes bidSignature;
        uint256 sellOrderPaymentAmount;
        uint256 sellOrderNftAmount;
        bool isMakeFillBuyer;
    }

    // State variables
    address public operator;
    address public feeRecipient;
    mapping(bytes32 => uint256) public fills;
    mapping(address => uint256) public userNonces;

    // Events
    event OrderCancelled(bytes32 indexed orderHash);
    event Match(
        bytes32 indexed leftOrderHash,
        bytes32 indexed rightOrderHash,
        uint256 newLeftFill,
        uint256 newRightFill
    );

    constructor(
        address _operator,
        address _admin,
        address _manager,
        address _feeRecipient
    ) EIP712("Exchange", "1") ExchangeAccess(_admin, _manager) {
        if (
            _operator == address(0) ||
            _admin == address(0) ||
            _manager == address(0) ||
            _feeRecipient == address(0)
        ) {
            revert ZeroAddress();
        }

        operator = _operator;
        feeRecipient = _feeRecipient;
    }

    /**
     * @notice Cancels an existing order
     * @param order The order to cancel
     * @dev `salt` is used to prevent duplicate orders and protect against Replay Attacks.
     * If `salt == 0`, it indicates an invalid order or one created without a unique `salt`.
     * Since on-chain order creation (`fillOrder`) does not explicitly require `salt`,
     * such orders may not be cancellable.
     */
    function cancelOrder(Order calldata order) external {
        if (order.maker != msg.sender) {
            revert NotMaker();
        }
        if (order.salt == 0) {
            revert SaltIsZero();
        }
        bytes32 orderHash = _hashOrderKey(order);
        fills[orderHash] = type(uint256).max;
        emit OrderCancelled(orderHash);
    }

    /**
     * @notice Fills a purchase order with specified fees
     * @param orderData The purchase order data containing order details
     * @param sellerFee Fee percentage for the seller in basis points
     * @param buyerFee Fee percentage for the buyer in basis points
     * @param backendSignature Signature from backend validating the fees
     */
    function fillOrder(
        Purchase calldata orderData,
        uint256 sellerFee,
        uint256 buyerFee,
        bytes calldata backendSignature
    ) external {
        _validateUsersAndAssets(
            msg.sender,
            orderData.sellOrderMaker,
            orderData.token,
            orderData.paymentToken
        );
        Order memory sellOrder = Order(
            orderData.sellOrderMaker,
            Asset(
                AssetType(orderData.nftAssetClass),
                orderData.token,
                orderData.value,
                orderData.tokenId
            ),
            address(0),
            Asset(
                AssetType(AssetType.ERC20),
                orderData.paymentToken,
                orderData.sellOrderPaymentAmount,
                0
            ),
            orderData.sellOrderSalt,
            orderData.sellOrderStart,
            orderData.sellOrderEnd,
            orderData.isMakeFillSeller
        );

        bytes32 sellOrderHash = _hashOrder(sellOrder);

        _validateBackendSignature(
            sellOrderHash,
            bytes32(0),
            sellerFee,
            buyerFee,
            userNonces[msg.sender],
            0,
            backendSignature
        );

        Order memory buyOrder = Order(
            msg.sender,
            Asset(
                AssetType(AssetType.ERC20),
                orderData.paymentToken,
                orderData.buyOrderPaymentAmount,
                0
            ),
            address(0),
            Asset(
                AssetType(orderData.nftAssetClass),
                orderData.token,
                orderData.buyOrderNftAmount,
                orderData.tokenId
            ),
            0,
            0,
            0,
            false
        );

        userNonces[msg.sender] += 1;

        _validateFull(sellOrder, orderData.sellOrderSignature);

        _matchAndTransfer(sellOrder, buyOrder, sellerFee, buyerFee);
    }

    /**
     * @notice Fills an accept bid order with specified fees
     * @param orderData The accept bid order data containing order details
     * @param sellerFee Fee percentage for the seller in basis points
     * @param buyerFee Fee percentage for the buyer in basis points
     * @param backendSignature Signature from backend validating the fees
     */
    function fillOrder(
        AcceptBid calldata orderData,
        uint256 sellerFee,
        uint256 buyerFee,
        bytes calldata backendSignature
    ) external {
        _validateUsersAndAssets(
            msg.sender,
            orderData.bidMaker,
            orderData.token,
            orderData.paymentToken
        );
        Order memory buyOrder = Order(
            orderData.bidMaker,
            Asset(
                AssetType(AssetType.ERC20),
                orderData.paymentToken,
                orderData.bidPaymentAmount,
                0
            ),
            address(0),
            Asset(
                AssetType(orderData.nftAssetClass),
                orderData.token,
                orderData.value,
                orderData.tokenId
            ),
            orderData.bidSalt,
            orderData.bidStart,
            orderData.bidEnd,
            orderData.isMakeFillBuyer
        );

        bytes32 buyOrderHash = _hashOrder(buyOrder);

        _validateBackendSignature(
            bytes32(0),
            buyOrderHash,
            sellerFee,
            buyerFee,
            0,
            userNonces[msg.sender],
            backendSignature
        );

        Order memory sellOrder = Order(
            msg.sender,
            Asset(
                AssetType(orderData.nftAssetClass),
                orderData.token,
                orderData.sellOrderNftAmount,
                orderData.tokenId
            ),
            address(0),
            Asset(
                AssetType(AssetType.ERC20),
                orderData.paymentToken,
                orderData.sellOrderPaymentAmount,
                0
            ),
            0,
            0,
            0,
            false
        );

        userNonces[msg.sender] += 1;

        _validateFull(buyOrder, orderData.bidSignature);

        _matchAndTransfer(sellOrder, buyOrder, sellerFee, buyerFee);
    }

    /**
     * @notice Matches two orders with specified fees
     * @param orderLeft First order to match
     * @param orderRight Second order to match
     * @param signatureLeft Signature for the first order
     * @param signatureRight Signature for the second order
     * @param sellerFee Fee percentage for the seller in basis points
     * @param buyerFee Fee percentage for the buyer in basis points
     * @param backendSignature Signature from backend validating the fees
     */
    function matchOrders(
        Order memory orderLeft,
        Order memory orderRight,
        bytes memory signatureLeft,
        bytes memory signatureRight,
        uint256 sellerFee,
        uint256 buyerFee,
        bytes memory backendSignature
    ) external {
        _validateCollectionsAndUsers(orderLeft, orderRight);
        _validateSignaturesAndNonces(
            orderLeft,
            orderRight,
            signatureLeft,
            signatureRight,
            sellerFee,
            buyerFee,
            backendSignature
        );
        _matchAndTransfer(orderLeft, orderRight, sellerFee, buyerFee);
    }

    /**
     * @notice Gets the fill amount for a given order
     * @param order The order to check
     * @return The amount the order has been filled
     */
    function getOrderFillAmount(
        Order calldata order
    ) external view returns (uint256) {
        bytes32 orderHash = _hashOrderKey(order);
        return fills[orderHash];
    }

    function _validateCollectionsAndUsers(
        Order memory orderLeft,
        Order memory orderRight
    ) private view {
        FeeSide side = _getFeeSide(
            orderLeft.makeAsset.assetClass,
            orderLeft.takeAsset.assetClass
        );

        (address collection, address paymentToken) = side == FeeSide.LEFT
            ? (orderLeft.takeAsset.token, orderLeft.makeAsset.token)
            : (orderLeft.makeAsset.token, orderLeft.takeAsset.token);

        _validateUsersAndAssets(
            orderLeft.maker,
            orderRight.maker,
            collection,
            paymentToken
        );
    }

    function _validateSignaturesAndNonces(
        Order memory orderLeft,
        Order memory orderRight,
        bytes memory signatureLeft,
        bytes memory signatureRight,
        uint256 sellerFee,
        uint256 buyerFee,
        bytes memory backendSignature
    ) private {
        bytes32 leftOrderHash = _hashOrder(orderLeft);
        bytes32 rightOrderHash = _hashOrder(orderRight);

        _validateBackendSignature(
            leftOrderHash,
            rightOrderHash,
            sellerFee,
            buyerFee,
            userNonces[orderLeft.maker],
            userNonces[orderRight.maker],
            backendSignature
        );

        userNonces[orderLeft.maker] += 1;
        userNonces[orderRight.maker] += 1;

        _validateOrders(orderLeft, signatureLeft, orderRight, signatureRight);
    }

    function _handlePayment(
        address paymentToken,
        address buyer,
        address seller,
        uint256 amount,
        uint256 sellerFee,
        uint256 buyerFee
    ) private {
        if (sellerFee + buyerFee > BASIS_POINTS) revert FeesTooHigh();

        uint256 buyerFeeAmount = (amount * buyerFee) / BASIS_POINTS;
        uint256 sellerFeeAmount = (amount * sellerFee) / BASIS_POINTS;
        uint256 sellerAmount = amount - sellerFeeAmount;

        uint256 totalFromBuyer = amount + buyerFeeAmount;
        IERC20(paymentToken).safeTransferFrom(
            buyer,
            address(this),
            totalFromBuyer
        );

        IERC20(paymentToken).safeTransfer(seller, sellerAmount);

        IERC20(paymentToken).safeTransfer(
            feeRecipient,
            buyerFeeAmount + sellerFeeAmount
        );
    }

    function _transferNonFungibleAsset(
        Asset memory asset,
        address from,
        address to,
        uint256 amount
    ) private {
        if (asset.assetClass == AssetType.ERC721) {
            IERC721(asset.token).safeTransferFrom(from, to, asset.tokenId);
        } else if (asset.assetClass == AssetType.ERC1155) {
            IERC1155(asset.token).safeTransferFrom(
                from,
                to,
                asset.tokenId,
                amount,
                ""
            );
        }
    }

    function _validateBackendSignature(
        bytes32 sellOrderHash,
        bytes32 buyOrderHash,
        uint256 sellerFee,
        uint256 buyerFee,
        uint256 sellerNonce,
        uint256 buyerNonce,
        bytes memory signature
    ) private view {
        bytes32 structHash = keccak256(
            abi.encode(
                BACKEND_TYPEHASH,
                sellerFee,
                buyerFee,
                sellOrderHash,
                buyOrderHash,
                sellerNonce,
                buyerNonce
            )
        );

        bytes32 digest = _hashTypedDataV4(structHash);

        if (
            !SignatureChecker.isValidSignatureNow(operator, digest, signature)
        ) {
            revert InvalidBackendSignature();
        }
    }

    function _validateFull(
        Order memory order,
        bytes memory signature
    ) private view {
        _validateOrderTiming(order);
        _validateSignature(order, signature);
    }

    function _validateOrderTiming(Order memory order) private view {
        if (
            (order.start != 0 && order.start >= block.timestamp) ||
            (order.end != 0 && order.end <= block.timestamp)
        ) revert OrderValidationFailed();
    }

    function _validateSignature(
        Order memory order,
        bytes memory signature
    ) private view {
        bytes32 orderHash = _hashOrder(order);
        if (
            !SignatureChecker.isValidSignatureNow(
                order.maker,
                orderHash,
                signature
            )
        ) {
            revert InvalidSignature();
        }
    }

    function _validateOrders(
        Order memory orderLeft,
        bytes memory signatureLeft,
        Order memory orderRight,
        bytes memory signatureRight
    ) private view {
        _validateFull(orderLeft, signatureLeft);
        _validateFull(orderRight, signatureRight);
        if (orderLeft.taker != address(0)) {
            if (orderRight.maker != address(0)) {
                if (orderRight.maker != orderLeft.taker) {
                    revert OrderTakerMismatch();
                }
            }
        }
        if (orderRight.taker != address(0)) {
            if (orderLeft.maker != address(0)) {
                if (orderRight.taker != orderLeft.maker) {
                    revert OrderTakerMismatch();
                }
            }
        }
    }

    function _matchAndTransfer(
        Order memory orderLeft,
        Order memory orderRight,
        uint256 sellerFee,
        uint256 buyerFee
    ) private {
        (Asset memory makeMatch, Asset memory takeMatch) = _matchAssets(
            orderLeft,
            orderRight
        );
        LibFill.FillResult memory newFill = _setFills(orderLeft, orderRight);
        _transferFeeAndAssets(
            makeMatch,
            takeMatch,
            newFill,
            sellerFee,
            buyerFee,
            _getFeeSide(makeMatch.assetClass, takeMatch.assetClass),
            orderLeft.maker,
            orderRight.maker
        );
    }

    function _getFeeSide(
        AssetType makeAssetClass,
        AssetType takeAssetClass
    ) private pure returns (FeeSide feeSide) {
        if (makeAssetClass == AssetType.ERC20 && takeAssetClass == AssetType.ERC20) {
            return FeeSide.RIGHT;
        }
        
        if (makeAssetClass == AssetType.ERC20) {
            return FeeSide.LEFT;
        }
        if (takeAssetClass == AssetType.ERC20) {
            return FeeSide.RIGHT;
        }
        revert InvalidAssetPair();
    }

    function _matchAssets(
        Order memory orderLeft,
        Order memory orderRight
    ) private pure returns (Asset memory makeMatch, Asset memory takeMatch) {
        makeMatch = _matchAssets(orderLeft.makeAsset, orderRight.takeAsset);
        takeMatch = _matchAssets(orderRight.makeAsset, orderLeft.takeAsset);
        if (
            makeMatch.assetClass == AssetType.EMPTY ||
            takeMatch.assetClass == AssetType.EMPTY
        ) revert AssetsDoNotMatch();
    }

    function _matchAssets(
        Asset memory assetFirst,
        Asset memory assetSecond
    ) private pure returns (Asset memory) {
        if (assetFirst.assetClass != assetSecond.assetClass) {
            return Asset(AssetType.EMPTY, address(0), 0, 0);
        }

        if (assetFirst.assetClass == AssetType.ERC20) {
            if (assetFirst.token == assetSecond.token) {
                return assetFirst;
            }
            return Asset(AssetType.EMPTY, address(0), 0, 0);
        }

        if (assetFirst.assetClass == AssetType.ERC721) {
            if (
                assetFirst.token == assetSecond.token &&
                assetFirst.tokenId == assetSecond.tokenId
            ) {
                return assetFirst;
            }
            return Asset(AssetType.EMPTY, address(0), 0, 0);
        }

        if (assetFirst.assetClass == AssetType.ERC1155) {
            if (
                assetFirst.token == assetSecond.token &&
                assetFirst.tokenId == assetSecond.tokenId
            ) {
                return assetFirst;
            }
            return Asset(AssetType.EMPTY, address(0), 0, 0);
        }

        return Asset(AssetType.EMPTY, address(0), 0, 0);
    }

    function _setFills(
        Order memory orderLeft,
        Order memory orderRight
    ) private returns (LibFill.FillResult memory newFill) {
        bytes32 leftOrderHash = _hashOrderKey(orderLeft);
        bytes32 rightOrderHash = _hashOrderKey(orderRight);

        uint256 leftOrderFill = _getOrderFill(orderLeft.salt, leftOrderHash);
        uint256 rightOrderFill = _getOrderFill(orderRight.salt, rightOrderHash);

        newFill = LibFill.fillOrder(
            orderLeft,
            orderRight,
            leftOrderFill,
            rightOrderFill,
            orderLeft.isMakeFill,
            orderRight.isMakeFill
        );

        if (orderLeft.makeAsset.value != 0 || orderRight.takeAsset.value != 0) {
            if (newFill.leftValue == 0) revert NothingToFill();
        }
        if (orderLeft.takeAsset.value != 0 || orderRight.makeAsset.value != 0) {
            if (newFill.rightValue == 0) revert NothingToFill();
        }

        if (orderLeft.salt != 0) {
            if (orderLeft.isMakeFill) {
                fills[leftOrderHash] = leftOrderFill + newFill.leftValue;
            } else {
                fills[leftOrderHash] = leftOrderFill + newFill.rightValue;
            }
        }

        if (orderRight.salt != 0) {
            if (orderRight.isMakeFill) {
                fills[rightOrderHash] = rightOrderFill + newFill.rightValue;
            } else {
                fills[rightOrderHash] = rightOrderFill + newFill.leftValue;
            }
        }

        emit Match(
            leftOrderHash,
            rightOrderHash,
            newFill.rightValue,
            newFill.leftValue
        );

        return newFill;
    }

    function _getOrderFill(
        uint salt,
        bytes32 hash
    ) private view returns (uint fill) {
        if (salt == 0) {
            fill = 0;
        } else {
            fill = fills[hash];
        }
    }

    function _transferFeeAndAssets(
        Asset memory makeMatch,
        Asset memory takeMatch,
        LibFill.FillResult memory fillResult,
        uint256 sellerFee,
        uint256 buyerFee,
        FeeSide feeSide,
        address leftMaker,
        address rightMaker
    ) private {
        if (feeSide == FeeSide.LEFT) {
            _handlePayment(
                makeMatch.token,
                leftMaker,
                rightMaker,
                fillResult.leftValue,
                sellerFee,
                buyerFee
            );

            _transferNonFungibleAsset(takeMatch, rightMaker, leftMaker, fillResult.rightValue);
        } else if (feeSide == FeeSide.RIGHT) {
            _handlePayment(
                takeMatch.token,
                rightMaker,
                leftMaker,
                fillResult.rightValue,
                sellerFee,
                buyerFee
            );

            if (makeMatch.assetClass == AssetType.ERC20) {
                IERC20(makeMatch.token).safeTransferFrom(
                    leftMaker,
                    rightMaker,
                    fillResult.leftValue
                );
            } else {
                _transferNonFungibleAsset(makeMatch, leftMaker, rightMaker, fillResult.leftValue);
            }
        }
    }

    function _hashOrderKey(Order memory order) private pure returns (bytes32) {
        return
            keccak256(
                abi.encode(
                    order.maker,
                    _hashAsset(order.makeAsset),
                    _hashAsset(order.takeAsset),
                    order.salt
                )
            );
    }

    function _hashOrder(Order memory order) private view returns (bytes32) {
        return
            _hashTypedDataV4(
                keccak256(
                    abi.encode(
                        ORDER_TYPEHASH,
                        order.maker,
                        _hashAsset(order.makeAsset),
                        order.taker,
                        _hashAsset(order.takeAsset),
                        order.salt,
                        order.start,
                        order.end,
                        order.isMakeFill
                    )
                )
            );
    }

    function _hashAsset(Asset memory asset) private pure returns (bytes32) {
        return
            keccak256(
                abi.encode(
                    asset.assetClass,
                    asset.token,
                    asset.value,
                    asset.tokenId
                )
            );
    }
}



