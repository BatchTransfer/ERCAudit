pragma solidity ^0.7.6;
pragma abicoder v2;

contract Test is EIP712("1inch RFQ", "2") {

    struct OrderRFQ {
        uint256 info;
        address makerAsset;
        address takerAsset;
        address maker;
        address allowedSender;
        uint256 makingAmount;
        uint256 takingAmount;
    }

    bytes32 constant private LIMIT_ORDER_RFQ_TYPEHASH = keccak256(
        "OrderRFQ(uint256 info,address makerAsset,address takerAsset,address maker,address allowedSender,uint256 makingAmount,uint256 takingAmount)"
    );

    function recover(
        OrderRFQ memory order,
        bytes calldata signature
    ) public view returns(address) {
        bytes32 orderHash = _hashTypedDataV4(keccak256(abi.encode(LIMIT_ORDER_RFQ_TYPEHASH, order)));
        return _validate(orderHash, signature);
    }

    function _validate(bytes32 orderHash, bytes calldata signature) private pure returns (address) {
        return ECDSA.tryRecover(orderHash, signature);
    }
}